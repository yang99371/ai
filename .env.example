# ============ 模型密钥（全部只放服务端环境变量）============
# 豆包：火山方舟
DOUBAO_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 千问：阿里云百炼（OpenAI 兼容 /chat/completions）
# 没有它时，页面里「通义千问 Plus」会提示缺少密钥
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek / Kimi 默认走方舟（复用 DOUBAO_API_KEY）；
# 想用官方网关就填下面的 key，并配合 *_BASE_URL 一起改
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=

# ============ 每个模型的覆盖项（都可省略）============
# 语法：<PROVIDER>_MODEL / <PROVIDER>_BASE_URL / <PROVIDER>_API_KEY / <PROVIDER>_API
# PROVIDER 取值：DOUBAO / DEEPSEEK / QWEN / KIMI；API 取值：responses 或 chat

# DOUBAO_MODEL=doubao-seed-2-1-pro-260915
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# DEEPSEEK_MODEL=deepseek-v4-1-flash-261017
# KIMI_MODEL=kimi-k3-1-pro-261024
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_API=chat

# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API=chat

# ============ Supabase ============
SUPABASE_URL=https://xxxx.supabase.co
# 推荐：service_role（绕过 RLS，仅服务端）
SUPABASE_SERVICE_ROLE_KEY=
# 退路：publishable / anon key（需要建表时放开 insert 策略，见 supabase.sql）
SUPABASE_ANON_KEY=
# SUPABASE_TABLE=name_records
